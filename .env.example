# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL (get from https://neon.tech → your project → Connection Details)
# Select "Prisma" from the connection string dropdown to get both URLs
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your free API key at https://resend.com (3,000 emails/month free)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address — use "onboarding@resend.dev" for testing, or a verified domain
EMAIL_FROM="TrackIt <onboarding@resend.dev>"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32  (or any 32+ character random string)
NEXTAUTH_SECRET="your-random-secret-here"
AUTH_SECRET="your-random-secret-here"

# Set to your Vercel deployment URL in production
NEXTAUTH_URL="https://your-app.vercel.app"
