# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL — get both URLs from https://neon.tech → Connection Details → Prisma
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST="your-smtp-host.com"
MAIL_PORT="465"
MAIL_USERNAME="you@yourdomain.com"
MAIL_PASSWORD="your-smtp-password"
MAIL_FROM_ADDRESS="you@yourdomain.com"
MAIL_FROM_NAME="FastCargo"

# ─── SwiftSMS (Bulk SMS) ──────────────────────────────────────────────────────
# API docs: https://swiftsms.macroit.org/api_docs
SWIFTSMS_API_URL="https://swiftsms.macroit.org/api/send_message"
SWIFTSMS_API_TOKEN="your-swiftsms-bearer-token"
SWIFTSMS_SENDER_ID="FASTCARGO"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
AUTH_SECRET="your-random-secret-here"                       
NEXTAUTH_URL="https://your
